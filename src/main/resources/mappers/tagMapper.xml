<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.traffic.practice.mapper.TagMapper">

    <insert id="register" parameterType="com.traffic.practice.dto.TagDTO">
        INSERT INTO tag (name, url, post_id)
        VALUES (#{name}, #{url}, #{postId})
        <selectKey keyProperty="id" resultType="java.lang.Long">
            SELECT LAST_INSERT_ID()
        </selectKey>
    </insert>

    <update id="updateTags" parameterType="com.traffic.practice.dto.TagDTO">
        UPDATE tag
        SET name=#{name}, url=#{url}, updated_time=#{updatedTime}
        WHERE id = #{id}
    </update>

    <delete id="deletePostTags" parameterType="java.lang.Long">
        DELETE FROM tag
        WHERE id = #{tagId}
    </delete>

    <insert id="createPostTags">
        INSERT INTO post_tag (post_id, tag_id)
        VALUES (#{postId}, #{tagId})
    </insert>

</mapper>
